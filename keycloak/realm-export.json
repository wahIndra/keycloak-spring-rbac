{
  "realm": "myrealm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(3)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "CODE_TO_TOKEN",
    "CODE_TO_TOKEN_ERROR",
    "REFRESH_TOKEN",
    "REFRESH_TOKEN_ERROR"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "client": {
      "leads-api": [
        {
          "name": "LEADS_READ",
          "description": "Read leads"
        },
        {
          "name": "LEADS_WRITE",
          "description": "Create and update leads"
        },
        {
          "name": "B2B_LEADS_SUBMIT",
          "description": "Partners submit leads through the B2B endpoint"
        },
        {
          "name": "MOBILE_ACCESS",
          "description": "Access the mobile endpoints"
        },
        {
          "name": "LEADS_OPERATOR",
          "description": "Composite role: LEADS_READ + LEADS_WRITE",
          "composite": true,
          "composites": {
            "client": {
              "leads-api": [
                "LEADS_READ",
                "LEADS_WRITE"
              ]
            }
          }
        }
      ],
      "orders-api": [
        {
          "name": "ORDERS_WRITE",
          "description": "Create and update orders"
        },
        {
          "name": "PAYMENTS_WRITE",
          "description": "Create and update payments"
        }
      ]
    }
  },
  "groups": [
    {
      "name": "cs-agent",
      "path": "/cs-agent",
      "clientRoles": {
        "leads-api": [
          "LEADS_READ"
        ]
      }
    },
    {
      "name": "cs-supervisor",
      "path": "/cs-supervisor",
      "clientRoles": {
        "leads-api": [
          "LEADS_OPERATOR"
        ]
      }
    },
    {
      "name": "mobile-users",
      "path": "/mobile-users",
      "clientRoles": {
        "leads-api": [
          "MOBILE_ACCESS"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "leads-api",
      "name": "Leads API (resource server)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "orders-api",
      "name": "Orders API (resource server)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "partner-xyz",
      "name": "Partner XYZ (machine to machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "partner-xyz-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-leads-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "leads-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "partner-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "partner_id",
            "claim.value": "XYZ001",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "billing-service",
      "name": "Billing service (internal, machine to machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "billing-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-leads-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "leads-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "orders-client",
      "name": "Orders client (machine to machine)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "orders-client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-orders-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "orders-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "web-portal",
      "name": "Web portal (users log in here)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-leads-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "leads-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dev-cli",
      "name": "LOCAL TESTING ONLY - password grant for curl. Never create this client in a real environment.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "basic",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "audience-leads-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "leads-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "leads-api": [
      {
        "client": "partner-xyz",
        "roles": [
          "B2B_LEADS_SUBMIT",
          "LEADS_READ"
        ]
      },
      {
        "client": "billing-service",
        "roles": [
          "LEADS_READ"
        ]
      },
      {
        "client": "web-portal",
        "roles": [
          "LEADS_READ",
          "LEADS_WRITE",
          "LEADS_OPERATOR",
          "MOBILE_ACCESS"
        ]
      },
      {
        "client": "dev-cli",
        "roles": [
          "LEADS_READ",
          "LEADS_WRITE",
          "LEADS_OPERATOR",
          "MOBILE_ACCESS"
        ]
      }
    ],
    "orders-api": [
      {
        "client": "orders-client",
        "roles": [
          "ORDERS_WRITE",
          "PAYMENTS_WRITE"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "service-account-partner-xyz",
      "enabled": true,
      "serviceAccountClientId": "partner-xyz",
      "clientRoles": {
        "leads-api": [
          "B2B_LEADS_SUBMIT",
          "LEADS_READ"
        ]
      }
    },
    {
      "username": "service-account-billing-service",
      "enabled": true,
      "serviceAccountClientId": "billing-service",
      "clientRoles": {
        "leads-api": [
          "LEADS_READ"
        ]
      }
    },
    {
      "username": "service-account-orders-client",
      "enabled": true,
      "serviceAccountClientId": "orders-client",
      "clientRoles": {
